<div class="luxsum-manager-body">
  <nav class="luxsum-tabs" data-group="primary">
    <a class="item {{#if (eq activeTab "my-companions")}}active{{/if}}" data-tab="my-companions">{{localize "LUXSUM.Manager.Tab.MyCompanions"}}</a>
    <a class="item {{#if (eq activeTab "spawn-new")}}active{{/if}}" data-tab="spawn-new">{{localize "LUXSUM.Manager.Tab.SpawnNew"}}</a>
    {{#if isGM}}
      <a class="item {{#if (eq activeTab "all-companions")}}active{{/if}}" data-tab="all-companions">{{localize "LUXSUM.Manager.Tab.AllCompanions"}}</a>
      <a class="item {{#if (eq activeTab "templates")}}active{{/if}}" data-tab="templates">{{localize "LUXSUM.Manager.Tab.Templates"}}</a>
    {{/if}}
    <a class="item {{#if (eq activeTab "settings")}}active{{/if}}" data-tab="settings">{{localize "LUXSUM.Manager.Tab.Settings"}}</a>
  </nav>

  <section class="luxsum-tab-body">
    {{#if (eq activeTab "my-companions")}}
      <div class="luxsum-companion-grid">
        {{#each myCompanions}}{{> "modules/luxurious-summons/templates/partials/companion-card.hbs"}}{{else}}
          <p class="luxsum-empty">{{localize "LUXSUM.Manager.Empty.MyCompanions"}}</p>
        {{/each}}
      </div>
    {{/if}}
    {{#if (eq activeTab "spawn-new")}}
      <div class="luxsum-template-gallery">
        {{#each templates}}{{> "modules/luxurious-summons/templates/partials/template-card.hbs"}}{{else}}
          <p class="luxsum-empty">{{localize "LUXSUM.Manager.Empty.SpawnNew"}}</p>
        {{/each}}
      </div>
    {{/if}}
    {{#if (eq activeTab "all-companions")}}
      <div class="luxsum-gm-console">
        {{> "modules/luxurious-summons/templates/partials/gm-global-controls.hbs" gm}}

        <div class="luxsum-restyle-group">
          <details class="luxsum-gm-collapse" open>
            <summary>{{localize "LUXSUM.GmConsole.PerTemplateMotion"}}</summary>
            <div class="luxsum-gm-template-rows">
              {{#each gm.templateRows}}{{> "modules/luxurious-summons/templates/partials/gm-template-motion-row.hbs"}}{{/each}}
            </div>
            <div class="luxsum-gm-show-all">
              <a data-action="gm-show-all">{{#if gm.showAll}}{{localize "LUXSUM.GmConsole.ShowActiveOnly"}}{{else}}{{localize "LUXSUM.GmConsole.ShowAllTemplates"}}{{/if}}</a>
            </div>
          </details>
          <span class="luxsum-fleur"><svg viewBox="0 0 24 24"><use href="#luxsum-fleur"/></svg></span>
        </div>

        <div class="luxsum-restyle-group" style="padding-bottom: 4px;">
          <h5 class="luxsum-restyle-group-title">{{localize "LUXSUM.GmConsole.ActiveCompanions"}} <span class="luxsum-gm-count">{{gm.shownCount}} / {{gm.totalCount}}</span></h5>
          <div class="luxsum-gm-filters">
            {{#each gm.chips}}
              <span class="luxsum-gm-chip {{#if active}}active{{/if}}" data-gm-chip data-user-id="{{id}}">{{#if color}}<span class="luxsum-gm-chip-dot" style="--chip-color:{{color}}"></span>{{/if}}{{name}}</span>
            {{/each}}
          </div>
          <div class="luxsum-gm-grid">
            {{#each gm.companions}}{{> "modules/luxurious-summons/templates/partials/gm-companion-card.hbs"}}{{else}}
              <div class="luxsum-gm-empty" style="grid-column: 1/-1">{{localize "LUXSUM.GmConsole.Empty"}}</div>
            {{/each}}
          </div>
        </div>
      </div>
    {{/if}}
    {{#if (eq activeTab "templates")}}
      <div class="luxsum-gm-console">
        <div class="luxsum-restyle-group" style="padding-bottom: 4px;">
          <h5 class="luxsum-restyle-group-title">{{localize "LUXSUM.Editor.Title"}}</h5>
          <p class="luxsum-gm-editor-hint">{{localize "LUXSUM.Editor.Hint"}}</p>
          <div class="luxsum-gm-editor-list">
            {{#each gm.editorTemplates}}{{> "modules/luxurious-summons/templates/partials/gm-template-editor-card.hbs"}}{{/each}}
          </div>
        </div>
      </div>
    {{/if}}
    {{#if (eq activeTab "settings")}}
      <div class="luxsum-gm-console">
        <div class="luxsum-restyle-group">
          <h5 class="luxsum-restyle-group-title">{{localize "LUXSUM.Manager.Tab.Settings"}}</h5>
          <p class="luxsum-gm-editor-hint">{{localize "LUXSUM.SettingsTab.Hint"}}</p>
          <span role="button" tabindex="0" class="luxsum-gm-editor-btn" data-action="open-module-settings"><i class="fa-solid fa-gears"></i> {{localize "LUXSUM.SettingsTab.OpenButton"}}</span>
        </div>
      </div>
    {{/if}}
  </section>
</div>
