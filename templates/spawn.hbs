<div class="luxsum-spawn-body">
  <div class="luxsum-spawn-header">
    <img class="luxsum-spawn-thumb" src="{{template.thumbnail}}">
    <div>
      <h2>{{template.name}}</h2>
      <p>{{template.description}}</p>
    </div>
  </div>

  <div class="luxsum-spawn-form">
    <label>
      {{localize "LUXSUM.Spawn.SourceLabel"}}
      <select name="sourceActorId" {{#if sourceLocked}}disabled{{/if}}>
        {{#each candidateActors}}
          <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </label>
    <p class="luxsum-spawn-info">Spawning {{template.maxActive}} token(s) per Place.</p>
  </div>

  <footer class="luxsum-spawn-footer">
    <span role="button" tabindex="0" data-action="cancel">{{localize "LUXSUM.Spawn.CancelBtn"}}</span>
    <span role="button" tabindex="0" class="luxsum-spawn-place" data-action="place">{{localize "LUXSUM.Spawn.PlaceBtn"}}</span>
  </footer>
</div>
